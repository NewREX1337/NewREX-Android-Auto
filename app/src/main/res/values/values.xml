<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">NewREX Android Auto</string>
    <string name="mirror_touch_label">NewREX ekran yansıtma dokunması</string>
    <string name="mirror_touch_desc">Telefon ekranı araca yansıtılırken, araç ekranındaki dokunmaları telefona iletir. Ekrandaki içeriği okumaz, hiçbir şeyi kaydetmez veya göndermez. Yalnızca dokunma, kaydırma ve geri/ana ekran tuşlarını kullanır.</string>

    <color name="icon_bg_start">#7C5CFF</color>
    <color name="icon_bg_end">#2F80ED</color>

    <style name="Theme.NewREX.Phone" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorAccent">#7C5CFF</item>
        <item name="android:colorPrimary">#7C5CFF</item>
        <item name="android:windowBackground">#0B0E1A</item>
        <item name="android:statusBarColor">#0B0E1A</item>
        <item name="android:navigationBarColor">#0B0E1A</item>
    </style>

    <style name="Theme.NewREX.Car" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:colorAccent">#7C5CFF</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:backgroundDimEnabled">false</item>
        <!-- Neon parlamalar için renkli gölgeler belirgin olsun -->
        <item name="android:ambientShadowAlpha">0.55</item>
        <item name="android:spotShadowAlpha">0.75</item>
    </style>

    <style name="Theme.NewREX.Translucent" parent="android:Theme.Translucent.NoTitleBar" />
</resources>
